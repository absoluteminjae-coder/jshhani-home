{
  "name": "jshhani-home",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/*.html",
      "/*/",
      "/doctor",
      "/reviews",
      "/shop",
      "/article",
      "/detail",
      "/product"
    ]
  }
}
